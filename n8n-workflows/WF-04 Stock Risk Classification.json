      "id": "21c0dbef-378b-4f37-9f0e-28a9a34b7e77",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "Products",
        "returnAll": true
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -432,
        -32
      ],
      "id": "693b175e-469c-4725-b9cc-97d4583dcc27",
      "name": "Fetch All Products",
      "credentials": {
        "supabaseApi": {
          "id": "cTHIcrIVh1Uh0w7G",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get all items from Fetch Products\nconst items = $input.all();\n\n// Process each item and classify risk\nconst classifiedItems = items.map(item => {\n  const product = item.json;\n  const days = product.days_to_stockout;\n  \n  // Determine risk level\n  let riskLevel = \"UNKNOWN\";\n  \n  if (days === null || days === undefined || days === \"\") {\n    riskLevel = \"UNKNOWN\";\n  } else if (days <= 3) {\n    riskLevel = \"HIGH\";\n  } else if (days <= 7) {\n    riskLevel = \"MEDIUM\";\n  } else {\n    riskLevel = \"LOW\";\n  }\n  \n  // Return object for Supabase update\n  return {\n    json: {\n      product_id: product.product_id,\n      risk_level: riskLevel\n    }\n  };\n});\n\nreturn classifiedItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        -32
      ],
      "id": "bbfca0e5-57a3-471b-923f-dd1de9aa850c",
      "name": "Process All Items"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "Products",
        "filters": {
          "conditions": [
            {
              "keyName": "product_id",
              "condition": "eq",
              "keyValue": "={{ $json.product_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "risk_level",
              "fieldValue": "={{ $json.risk_level }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -16,
