  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        208
      ],
      "id": "f63934f4-2bec-48e7-9f2d-27c6243e0731",
      "name": "When clicking 'Execute workflow'",
      "notesInFlow": true,
      "notes": "Manual entry point for testing.\nUse to run the inventory processor independently."
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "bbf8261d-093b-4ebe-9156-1b63a190935e",
      "name": "When Executed by Another Workflow",
      "notesInFlow": true,
      "notes": "Sub-workflow entry point.\nCalled by WF-08 Daily Orchestrator during the daily pipeline."
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "Products",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "store_id",
              "condition": "eq",
              "keyValue": "={{ $json.store_id || ($json.body && $json.body.store_id ? $json.body.store_id : '') }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        208
      ],
      "id": "03b7f7b9-e022-4df8-929a-7f57879dc470",
      "name": "Fetch All Products",
      "notesInFlow": true,
      "credentials": {
        "supabaseApi": {
          "id": "cTHIcrIVh1Uh0w7G",
          "name": "Supabase account"
        }
      },
      "notes": "Retrieves all products from the Supabase Products table.\nNeeds current_stock and reorder_threshold for comparison."
    },
    {
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nconst products = $input.all().map(i => i.json);\nconst store_id = products[0]?.store_id || null;\n\nconst alerts = products\n  .filter(p => (parseInt(p.current_stock) || 0) <= (parseInt(p.reorder_threshold) || 0))\n  .map(p => ({\n    json: {\n      product_id: String(p.product_id),\n      product_name: String(p.product_name).trim(),\n      alert_name: `Low Stock Alert: ${String(p.product_name).trim()}`,\n      alert_date: now,\n      current_stock: parseInt(p.current_stock) || 0,\n      reorder_threshold: parseInt(p.reorder_threshold) || 0,\n      alert_status: 'Active',\n      store_id: p.store_id\n    }\n  }));\n\nif (alerts.length === 0) {\n  return [{ json: { skip: true, store_id } }];\n}\n\nreturn alerts;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        208
      ],
      "id": "2da16326-4ff8-40c8-80e5-dc40fd6b0fcb",
      "name": "Compute & Filter",
      "notesInFlow": true,
      "notes": "Filters products where current_stock <= reorder_threshold.\nBuilds alert objects with product_id, product_name, alert_name, current_stock, and alert_status='Active'.\nReturns skip=true if no low-stock products found."
    },
    {
      "id": "b7a3bc67-9e34-4559-920d-da2a8468b61f",
      "name": "Delete All Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "notes": "HTTP DELETE request to clear ALL existing rows from the Stock Alerts table.\nThis is a full-refresh approach - all alerts are regenerated each run.",
      "parameters": {
        "method": "DELETE",
        "url": "=https://xixdkapttirdedoivskx.supabase.co/rest/v1/Stock%20Alerts?store_id=eq.{{ $('Compute \u0026 Filter').first().json.store_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "value": "REDACTED_SUPABASE_ANON_KEY",
              "name": "apikey"
            },
            {
              "value": "Bearer REDACTED_SUPABASE_ANON_KEY",
              "name": "Authorization"
            },
            {
              "value": "return=minimal",
              "name": "Prefer"
            }
          ]
        },
        "options": {}
      },
      "notesInFlow": true,
      "position": [
        672,
        208
      ]
    },
    {
      "parameters": {
        "tableId": "Stock Alerts",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "product_id",
              "fieldValue": "={{ $json.product_id }}"
            },
            {
              "fieldId": "product_name",
              "fieldValue": "={{ $json.product_name }}"
            },
            {
              "fieldId": "alert_name",
              "fieldValue": "={{ $json.alert_name }}"
            },
            {
              "fieldId": "alert_date",
              "fieldValue": "={{ $json.alert_date }}"
            },
            {
              "fieldId": "current_stock",
              "fieldValue": "={{ $json.current_stock }}"
            },
            {
              "fieldId": "reorder_threshold",
              "fieldValue": "={{ $json.reorder_threshold }}"
            },
            {
              "fieldId": "alert_status",
              "fieldValue": "={{ $json.alert_status }}"
            },
            {
              "fieldId": "store_id",
              "fieldValue": "={{ $json.store_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1088,
        208
      ],
      "id": "76c24b3c-1d9e-4c9a-aa07-26082f0dceb0",
      "name": "Create Alerts",
      "notesInFlow": true,
      "credentials": {
        "supabaseApi": {
          "id": "cTHIcrIVh1Uh0w7G",
          "name": "Supabase account"
        }
      },
      "notes": "Inserts fresh Stock Alert rows into Supabase for each product that is currently below its reorder threshold."
    },
    {
      "parameters": {
        "jsCode": "return $('Compute & Filter').all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        208
      ],
      "id": "990bfc3e-4b61-44e1-a066-8913936ce200",
      "name": "Restore Data",
      "notesInFlow": true,
      "notes": "Restores the filtered alert data that was computed before the delete.\nNeeded because the HTTP delete node output replaces the pipeline data."
    },
    {
      "parameters": {
        "content": "## WF-03: Inventory Processing & Stock Alerts\n\n**Triggers:** Manual execution or sub-workflow call from WF-08\n\n**Purpose:** Identifies products with dangerously low stock levels and generates active alerts for the dashboard and WhatsApp notifications.\n\n**Strategy:** Full-refresh approach:\n1. Fetch all products from Supabase\n2. Filter where current_stock <= reorder_threshold\n3. Delete ALL existing Stock Alerts\n4. Re-create alerts for currently low-stock items\n\n**Note:** The delete-and-recreate pattern ensures alerts always reflect the current state. No stale alerts persist.",
        "height": 372,
        "width": 560
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        224,
        -256
      ],
