            "name": "Supabase account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Compute Daily Snapshot after entire pipeline completes\n// We need to fetch fresh product data and alert/suggestion counts\n// Since we're at the end of the pipeline, we reference earlier nodes\n\nconst products = $('Fetch Products').all().map(i => i.json);\nconst total = products.length;\n\n// Count by risk level (these were updated by WF-04 in the pipeline)\n// But since executeWorkflow doesn't return updated products, use what we have\n// and apply the stock changes from Simulate Stock\nconst simulated = $('Simulate Stock').all().map(i => i.json);\n\nlet oos = 0, high = 0, medium = 0, low = 0;\n\n// Use the simulated stock to estimate risk\nsimulated.forEach(s => {\n  if (s.current_stock === 0) oos++;\n  // Approximate risk from the original products data\n  const orig = products.find(p => p.product_id === s.product_id);\n  if (orig) {\n    const risk = orig.risk_level || 'UNKNOWN';\n    if (risk === 'HIGH') high++;\n    else if (risk === 'MEDIUM') medium++;\n    else if (risk === 'LOW') low++;\n  }\n});\n\n// Health score: 100 - (HIGH*15 + MEDIUM*5 + OOS*25) / total * weighting\n// Simple formula: percentage of non-problematic products\nconst problemScore = (high * 15 + medium * 5 + oos * 25);\nconst maxScore = total * 25; // worst case all OOS\nconst health = maxScore > 0 ? Math.round(Math.max(0, 100 - (problemScore / maxScore * 100))) : 100;\n\nconst today = new Date().toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    snapshot_date: today,\n    health_score: health,\n    total_products: total,\n    oos_count: oos,\n    high_count: high,\n    medium_count: medium,\n    low_count: low,\n    alerts_active: 0,\n    suggestions_pending: 0\n  }\n}];"
        },
