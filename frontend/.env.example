# ── Supabase ──────────────────────────────────────────────────────────
# Project URL from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (public) key from Supabase Dashboard → Settings → API
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── n8n ───────────────────────────────────────────────────────────────
# Base URL for n8n instance (ngrok tunnel or direct URL)
# In dev mode, Vite proxies /webhook/* and /api/v1/* so this is only used in production
VITE_N8N_BASE_URL=https://your-ngrok-subdomain.ngrok-free.dev

# n8n API key for triggering workflows via the public API
# Generate at: n8n Settings → API → Create API Key
VITE_N8N_API_KEY=your-n8n-api-key
